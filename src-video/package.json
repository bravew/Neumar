{
  "name": "@neumar/video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx remotion studio",
    "preview": "npx remotion preview src/index.ts",
    "render": "npx remotion render src/index.ts",
    "render:hero": "npx remotion render src/index.ts HeroDemo out/hero-demo.mp4 --codec=h264 --crf=18",
    "render:gif": "npx remotion render src/index.ts GithubPreview out/preview.gif --codec=gif",
    "render:all": "tsx scripts/render-all.ts",
    "capture": "tsx scripts/capture-screenshots.ts",
    "record": "tsx scripts/record-workflow.ts",
    "seed": "tsx scripts/seed-demo-data.ts",
    "docs:seed": "tsx scripts/seed-demo-data.ts",
    "docs:capture": "tsx scripts/capture-docs.ts",
    "docs:config:check": "tsx scripts/lib/docs-media-config.ts",
    "docs:render": "tsx scripts/render-docs.ts",
    "docs:render:compare": "tsx scripts/render-docs.ts --renderer=both",
    "docs:optimize": "tsx scripts/optimize-docs.ts",
    "docs:check": "tsx scripts/check-doc-media.ts",
    "docs:media:check": "pnpm docs:config:check && pnpm docs:check",
    "voiceover": "tsx scripts/generate-voiceover.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm docs:media:check"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.515",
    "@remotion/cli": "^4.0.515",
    "@remotion/google-fonts": "^4.0.515",
    "@remotion/media-utils": "^4.0.515",
    "@remotion/paths": "^4.0.515",
    "@remotion/shapes": "^4.0.515",
    "@remotion/tailwind": "^4.0.515",
    "@remotion/transitions": "^4.0.515",
    "remotion": "^4.0.515",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.515",
    "@remotion/renderer": "^4.0.515",
    "@types/node": "^25.9.3",
    "hyperframes": "0.8.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "sharp": "0.35.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
