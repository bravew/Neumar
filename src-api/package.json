{
  "name": "neumar-api",
  "version": "26.8.20",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @neumar/video-ir build",
    "dev": "touch .env && node --import tsx --env-file=.env --watch src/index.ts",
    "prebuild": "pnpm --filter @neumar/video-ir build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @neumar/video-ir build",
    "start": "node dist/index.js",
    "prebundle": "pnpm --filter @neumar/video-ir build",
    "bundle": "node scripts/build.mjs",
    "build:binary": "PKG_NODE_RANGE=22 pnpm bundle && pkg dist/bundle.cjs --compress Brotli --targets node22-macos-arm64 --output dist/neumar-api-aarch64-apple-darwin --options expose-gc",
    "build:binary:linux": "PKG_NODE_RANGE=22 pnpm bundle && pkg dist/bundle.cjs --compress Brotli --targets node22-linux-x64 --output dist/neumar-api-x86_64-unknown-linux-gnu --options expose-gc",
    "build:binary:windows": "PKG_NODE_RANGE=22 pnpm bundle && pkg dist/bundle.cjs --compress Brotli --targets node22-win-x64 --output dist/neumar-api-x86_64-pc-windows-msvc.exe --options expose-gc",
    "build:binary:mac-intel": "PKG_NODE_RANGE=22 pnpm bundle && pkg dist/bundle.cjs --compress Brotli --targets node22-macos-x64 --output dist/neumar-api-x86_64-apple-darwin --options expose-gc",
    "build:binary:mac-arm": "PKG_NODE_RANGE=22 pnpm bundle && pkg dist/bundle.cjs --compress Brotli --targets node22-macos-arm64 --output dist/neumar-api-aarch64-apple-darwin --options expose-gc",
    "build:binary:all": "pnpm run build:binary:linux && pnpm run build:binary:windows && pnpm run build:binary:mac-intel && pnpm run build:binary:mac-arm",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "validate": "pnpm lint && pnpm typecheck && pnpm format:check",
    "channels:smoke:readiness": "node scripts/channel-smoke-readiness.mjs",
    "plugin:new": "tsx src/cli/scaffold-plugin.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/encoder": "^0.0.57",
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@anthropic-ai/sandbox-runtime": "^0.0.71",
    "@anthropic-ai/sdk": "^0.116.0",
    "@codeany/open-agent-sdk": "^0.2.4",
    "@copilotkit/runtime": "^1.66.4",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.0",
    "@huggingface/transformers": "^4.2.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@linear/sdk": "^89.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neumar/video-ir": "workspace:*",
    "@remotion/bundler": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "@remotion/transitions": "4.0.507",
    "@slack/bolt": "^5.0.0",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.1",
    "chokidar": "^5.0.0",
    "cron-parser": "^5.7.0",
    "discord.js": "^14.27.0",
    "grammy": "^1.45.1",
    "hono": "^4.13.1",
    "jszip": "^3.10.1",
    "lru-cache": "^11.5.2",
    "nanoid": "^6.0.1",
    "onnxruntime-node": "^1.27.0",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "picomatch": "^4.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.507",
    "sharp": "^0.35.3",
    "sherpa-onnx-node": "1.13.6",
    "sqlite-vec": "0.1.9",
    "undici": "^7.29.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@contentauth/c2pa-node": "0.9.1",
    "@slack/types": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/pdf-parse": "1.1.5",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.22.0",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "pkg": {
    "scripts": [
      "dist/bundle.cjs",
      "node_modules/@remotion/bundler/**/*.js",
      "node_modules/@remotion/renderer/**/*.js",
      "node_modules/@remotion/transitions/**/*.js",
      "node_modules/remotion/**/*.js"
    ],
    "assets": [
      "dist/better_sqlite3.node"
    ],
    "outputPath": "dist"
  }
}
