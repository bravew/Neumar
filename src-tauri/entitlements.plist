<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation for Node.js/V8 sidecar -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (required by onnxruntime-node) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow loading libraries signed by other teams (required for native
         Node.js addons like better_sqlite3.node that pkg extracts at runtime) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Location services for geolocation context -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <!-- Microphone access for speech-to-text (required for macOS 14+ WKWebView) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Allow Tauri updater's macOS admin fallback to run AppleScript when
         replacing the app bundle requires elevated privileges. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
